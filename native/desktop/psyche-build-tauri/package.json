{
  "name": "psyche-build-tauri",
  "private": true,
  "version": "0.0.2",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:web:debug": "node scripts/build-web.mjs --debug",

    "build": "pnpm build:web && tauri build",
    "check:runtime-bundle": "pnpm build:web && git diff --exit-code -- web/runtime.bundle.js",
    "check:release-contract": "node ../../../scripts/verify-tauri-release-contract.mjs --target-dir src-tauri/target",
    "dev": "pnpm build:web:debug && tauri dev",
    "serve:web": "vite web --host 127.0.0.1 --port 1420 --strictPort --publicDir ../.psyche-dev-web/web"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/highlight": "1.2.3",
    "@opencoven/psyche-vim-core": "workspace:*",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "codemirror": "6.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.28.2",
    "vite": "8.2.1"
  }
}

{
  "$schema": "../gen/schemas/macOS-schema.json",
  "identifier": "default",
  "description": "Capability for the main psyche Tauri window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "allow-pty-start",
    "allow-pty-attach",
    "allow-pane-session-metrics",
    "allow-canonical-project-path",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-ack",
    "allow-pty-set-visibility",
    "allow-pty-stop",
    "allow-pty-list",
    "allow-pty-transport-metrics",
    "allow-browser-app-shortcut",
    "allow-browser-report-title",
    "allow-browser-automation-result",
    "allow-browser-navigate",
    "allow-browser-set-bounds",
    "allow-browser-hide",
    "allow-browser-hide-all-except",
    "allow-browser-destroy",
    "allow-browser-destroy-many",
    "allow-browser-current-url",
    "allow-browser-reload",
    "allow-browser-eval",
    "allow-browser-script",
    "allow-browser-snapshot",
    "allow-app-environment",
    "allow-coven-sessions",
    "allow-coven-session-kill",
    "allow-workspace-load",
    "allow-workspace-save",
    "allow-native-session-create",
    "allow-native-session-list",
    "allow-native-session-stop",
    "allow-native-session-capture",
    "allow-agent-skills",
    "allow-fs-list-dir",
    "allow-fs-read-text",
    "allow-fs-write-text",
    "allow-git-status",
    "allow-git-worktrees",
    "allow-git-diff",
    "allow-git-log",
    "allow-workspace-metrics",
    "allow-control-provider-start",
    "allow-control-provider-stop",
    "allow-control-provider-upsert",
    "allow-control-provider-remove",
    "allow-control-provider-complete",
    "allow-control-provider-shutdown",
    "allow-control-operator-submit",
    "allow-control-state",
    "allow-runtime-diagnostics",
    "allow-runtime-process-metrics"
  ]
}

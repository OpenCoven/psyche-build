{
  "$schema": "../gen/schemas/macOS-schema.json",
  "identifier": "default",
  "description": "Capability for the main psyche Tauri window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "opener:default",
    "dialog:default",
    "dialog:allow-open",
    "allow-pty-start",
    "allow-pane-session-metrics",
    "allow-canonical-project-path",
    "allow-pty-write",
    "allow-pty-ack",
    "allow-pty-resize",
    "allow-pty-stop",
    "allow-pty-list",
    "allow-browser-app-shortcut",
    "allow-browser-navigate",
    "allow-browser-set-bounds",
    "allow-browser-hide",
    "allow-browser-hide-all-except",
    "allow-browser-destroy",
    "allow-browser-destroy-many",
    "allow-browser-reload",
    "allow-browser-eval",
    "allow-app-environment",
    "allow-coven-sessions",
    "allow-coven-session-kill",
    "allow-workspace-load",
    "allow-workspace-save",
    "allow-agent-skills",
    "allow-fs-list-dir",
    "allow-fs-read-text",
    "allow-fs-write-text",
    "allow-git-status",
    "allow-git-worktrees",
    "allow-git-diff",
    "allow-git-log",
    "allow-workspace-metrics"
  ]
}

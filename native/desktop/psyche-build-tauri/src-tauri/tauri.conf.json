{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Psyche Build",
  "version": "0.0.2",
  "identifier": "dev.opencoven.psyche",
  "build": {
    "beforeDevCommand": "pnpm run serve:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Psyche Build",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self'; script-src 'self'; frame-src https: http:; connect-src 'self' ipc: http://ipc.localhost https: http:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "macos-fps": {
      "enabled": true
    },
    "opener": {}
  }
}

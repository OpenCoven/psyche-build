{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenCoven/psyche-build/blob/main/docs/psyche/canary-evidence.schema.json",
  "title": "Psyche compatibility canary evidence receipt",
  "description": "Bounded machine-readable evidence for one offline, credential-free compatibility canary run on an exact consumer head. result is pass only when every vector passed. Design reference for OpenCoven/psyche-build#253 delivery slice 3; see docs/PSYCHE-ADAPTER-PLAN.md section 4.3 and the sketch in docs/PSYCHE-COMPATIBILITY-MAP.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "consumer",
    "profile",
    "artifactDigestVerified",
    "environment",
    "vectors",
    "summary",
    "result",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": { "const": "OpenCoven/psyche-build" },
        "commitSha": { "$ref": "#/$defs/gitSha" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/profileId" },
        "digest": { "$ref": "#/$defs/sha256Hex" }
      }
    },
    "artifactDigestVerified": {
      "type": "boolean",
      "const": true,
      "description": "Evidence may only be produced for a run whose artifact digest was verified against the pin."
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci"],
      "properties": {
        "ci": { "type": "boolean" }
      }
    },
    "vectors": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "kind", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^psyche-canary-[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
          "category": {
            "enum": [
              "negotiation",
              "lifecycle",
              "denial",
              "authority-widening",
              "stale-correlation",
              "duplicate-retry",
              "ambiguity-fence",
              "restart",
              "downgrade",
              "unknown-enum",
              "unknown-version",
              "cancellation"
            ]
          },
          "kind": { "enum": ["positive", "negative"] },
          "result": { "enum": ["pass", "fail"] },
          "notes": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative"],
      "properties": {
        "positive": { "$ref": "#/$defs/kindSummary" },
        "negative": { "$ref": "#/$defs/kindSummary" }
      }
    },
    "result": { "enum": ["pass", "fail"] },
    "generatedAt": { "$ref": "#/$defs/iso8601Utc" }
  },
  "$defs": {
    "kindSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "profileId": {
      "type": "string",
      "pattern": "^opencoven\\.psyche\\.consumer@[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "iso8601Utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    }
  }
}
